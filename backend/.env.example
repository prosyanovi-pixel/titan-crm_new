# Порт сервера (Backend)
PORT=5001

# Настройки Базы Данных (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=titancrm
DB_USER=your_db_user
DB_PASSWORD=your_db_password

# Безопасность
JWT_SECRET=your_jwt_secret_key_here
DISABLE_AUTH=false

# Логирование (info, debug, error)
LOG_LEVEL=info

# Настройки почты (SMTP) - Опционально
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="TITAN CRM <no-reply@titan.com>"

# Шифрование (32 символа)
ENCRYPTION_KEY=your-32-character-encryption-key-here!

# Примечание: API ключи (DaData, API-FNS) и интеграции (Email, Telegram)
# хранятся в БД (system_settings), а не в .env
# Настройте их через админку после запуска:
# - Настройки → Управление модулями → Обогащение данных (DaData, API-FNS)
# - Настройки → Интеграции (Email, Telegram)
