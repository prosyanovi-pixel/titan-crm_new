# ============================================
# Конфигурация для разных операционных систем
# ============================================

# Порт сервера (Backend)
PORT=3001

# Базовый URL API (для скриптов бэкапа)
API_URL=http://localhost:3001

# Настройки Базы Данных (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=titancrm1
DB_USER=myuser
DB_PASSWORD=mysecretpassword

# ============================================
# Пути к утилитам PostgreSQL (НЕОБЯЗАТЕЛЬНО)
# ============================================
# Скрипт автоматически определяет пути на Windows, macOS и Linux.
# Указывайте вручную ТОЛЬКО если автоопределение не сработало.
#
# Порядок поиска:
#   1. Значение из этого файла (если задано)
#   2. Системный PATH (where/which)
#   3. Стандартные пути установки (PostgreSQL 12–18)
#   4. Bare-name как fallback
#
# Примеры:
#   Windows:               PG_DUMP_PATH=C:\Program Files\PostgreSQL\16\bin\pg_dump.exe
#   macOS Postgres.app:    PG_DUMP_PATH=/Applications/Postgres.app/Contents/Versions/17/bin/pg_dump
#   macOS Homebrew:        PG_DUMP_PATH=/opt/homebrew/bin/pg_dump
#   macOS EnterpriseDB:    PG_DUMP_PATH=/Library/PostgreSQL/17/bin/pg_dump
#   macOS MacPorts:        PG_DUMP_PATH=/opt/local/lib/postgresql17/bin/pg_dump
#   Linux:                 PG_DUMP_PATH=/usr/bin/pg_dump
#
#PG_DUMP_PATH=
#PSQL_PATH=

# ============================================
# Безопасность
# ============================================
JWT_SECRET=change_this_secret_key_to_something_secure
DISABLE_AUTH=false

# ============================================
# Логирование
# ============================================
LOG_LEVEL=info

# ============================================
# Настройки почты (SMTP) - Опционально
# ============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="TITAN CRM <no-reply@titan.com>"
SMTP_DOMAIN=titan.com
COMPANY_LOGO_URL=https://your-cdn.com/logo.png
