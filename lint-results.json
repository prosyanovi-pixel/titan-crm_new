selectedIds,\n  onSuccess\n}: ProductBulkEditDialogProps) {\n  const { t } = useTranslation();\n  const { getStatusesByModule, getTagsByModule } = useSettings();\n  const updateBulk = useUpdateProductBulk();\n  const { data: categories = [] } = useProductCategories();\n\n  const statuses = getStatusesByModule('products');\n  const tags = getTagsByModule('products');\n\n  const referenceData = {\n    statuses: statuses.map(s => ({ id: String(s.id), name: s.name })),\n    tags: tags.map(t => ({ id: String(t.id), name: t.name, color: t.color })),\n    productCategories: categories.map(c => ({ id: String(c.id), name: c.name }))\n  };\n\n  const handleConfirm = (field: string, value: any) => {\n    // For tags, value might be an array\n    const updates = { [field]: value };\n    updateBulk.mutate({ ids: selectedIds, updates }, {\n      onSuccess: () => {\n        if (onSuccess) onSuccess();\n        onOpenChange(false);\n      }\n    });\n  };\n\n  return (\n    <BulkEditDialog\n      open={open}\n      onOpenChange={onOpenChange}\n      onConfirm={handleConfirm}\n      count={count}\n      moduleId=\"products\"\n      title={t('products.bulk_edit_title')}\n      description={t('common.bulk_edit_desc')}\n      referenceData={referenceData}\n    />\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"/Users/titan/Documents/titan-crm/frontend/src/modules/products/components/ProductFormSheet.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/Users/titan/Documents/titan-crm/frontend/src/modules/products/components/ProductTableRow.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/Users/titan/Documents/titan-crm/frontend/src/modules/products/components/ProductsTable.tsx","messages":[],"suppressedMessages":[],"errorCount":