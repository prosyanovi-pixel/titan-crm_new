n                  <>\n                    <div className=\"flex items-center gap-3\">\n                      <IconComp className=\"w-4 h-4 text-muted-foreground\" />\n                      <span className=\"font-medium\">{tab.label}</span>\n                      <span className=\"text-xs text-muted-foreground ml-2 bg-muted px-2 py-1 rounded-md font-mono\">{tab.id}</span>\n                      {!tab.visible && <span className=\"text-xs text-destructive ml-2\">{t('settings.tabs_editor.hidden')}</span>}\n                    </div>\n                    <div className=\"flex items-center gap-2\">\n                      <Button variant=\"ghost\" size=\"icon\" onClick={() => handleEdit(tab)}><Edit2 className=\"w-4 h-4 text-muted-foreground\" /></Button>\n                      <Button variant=\"ghost\" size=\"icon\" onClick={() => handleDelete(tab.id)}><Trash2 className=\"w-4 h-4 text-destructive\" /></Button>\n                    </div>\n                  </>\n                )}\n              </CardContent>\n            </Card>\n          );\n        })}\n        {tabs.length === 0 && !isAdding && (\n          <div className=\"text-center py-8 text-muted-foreground border rounded-lg border-dashed\">\n            {t('common.no_data')}\n          </div>\n        )}\n      </div>\n    </div>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"/Users/titan/Documents/titan-crm/frontend/src/modules/settings/components/TagEditor.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/Users/titan/Documents/titan-crm/frontend/src/modules/settings/components/TypesEditor.tsx","messages":[{"ruleId":"@typescript-eslint/no-explicit-any","severity":1,"message":"Unexpected any. Specify a different type.","line":33,"column":43,"messageId":"unexpectedAny","endLine":33,"endColumn":46,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[1374,1377],"text":"unkn